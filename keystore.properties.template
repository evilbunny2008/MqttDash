# Copy this file to "keystore.properties" (same directory, project root) and
# fill in your real values. keystore.properties itself is gitignored - never
# commit real signing credentials to version control.
#
# storeFile: path to your .jks/.keystore file. Can be relative to the
# project root (e.g. "release-keystore.jks" if you place it right here) or
# an absolute path if you keep it somewhere else on disk entirely.
#
# If you already have a keystore from using Android Studio's "Generate
# Signed App Bundle / APK" wizard, reuse that same one here - the whole
# point is for every release build (APK or AAB, wizard or plain Gradle task)
# to end up signed with the same key, so installs are always treated as
# updates to the same app rather than triggering a signature-mismatch
# warning.
storeFile=release-keystore.jks
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
