{
  "comment": "This needs to be added to MQTT topic for the device as a retained message, that is zigbee2mqtt/Fan_01/app",
  "name": "Ceiling Fan",
  "group": "Fans",
  "group_comment": "group_order is for the order that collections of panels will appear in a group",
  "group_order": 1,
  "panels": [],
  "labels": [],
  "controls": [
    {
      "label": "Low",
      "state_topic": "z2m2/Fan_01",
      "state_field": "state_l3",
      "on_payload": {"state_l3": "ON"},
      "off_payload": {"state_l3": "OFF"}
    },
    {
      "label": "Medium",
      "state_topic": "z2m2/Fan_01",
      "state_field": "state_l4",
      "on_payload": {"state_l4": "ON"},
      "off_payload": {"state_l4": "OFF"}
    },
    {
      "label": "High",
      "state_topic": "z2m2/Fan_01",
      "state_field": "state_l2",
      "on_payload": {"state_l2": "ON"},
      "off_payload": {"state_l2": "OFF"}
    }
  ]
}
