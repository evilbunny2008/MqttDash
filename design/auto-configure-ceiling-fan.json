{
  "comment1": "This is an example of a combined light and 3 speed ceiling fan switch",
  "comment2": "This needs to be added to MQTT topic for the device as a retained message, that is zigbee2mqtt/Light_04/app",
  "name": "Ceiling Fan",
  "group": "Lights n Stuff",
  "group_order": 3,
  "panels": ["linkquality"],
  "labels": ["LQI"],
  "panel_clusters": ["Light"],
  "panel_order": [4],
  "controls": [
    {
      "label": "Low",
      "order": 1,
      "state_topic": "z2m2/Light_04",
      "state_field": "state_l3",
      "on_payload": {"state_l3": "ON"},
      "off_payload": {"state_l3": "OFF"}
    },
    {
      "label": "Medium",
      "order": 2,
      "state_topic": "z2m2/Light_04",
      "state_field": "state_l4",
      "on_payload": {"state_l4": "ON"},
      "off_payload": {"state_l4": "OFF"}
    },
    {
      "label": "High",
      "order": 3,
      "state_topic": "z2m2/Light_04",
      "state_field": "state_l2",
      "on_payload": {"state_l2": "ON"},
      "off_payload": {"state_l2": "OFF"}
    },
    {
      "label": "Light",
      "order": 5,
      "cluster": "Light",
      "state_topic": "z2m2/Light_04",
      "state_field": "state_l1",
      "on_payload": {"state_l1": "ON"},
      "off_payload": {"state_l1": "OFF"}
    }
  ]
}
